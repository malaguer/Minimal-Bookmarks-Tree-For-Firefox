{
  "manifest_version": 3,
  "name": "Minimal Bookmarks Tree",
  "version": "5.4.7",
  "description": "Display a tree of bookmarks under a toolbar button, and search your bookmarks in the omnibox using the keyword 'bm'.",
  "background": {
    "scripts": [
      "shims/storage-session-compat.js",
      "shims/execute-script-compat.js",
      "shims/sidepanel-compat.js",
      "shims/declarative-net-request-stub.js",
      "shims/user-scripts-compat.js",
      "shims/tabs-windows-compat.js",
      "shims/runtime-compat.js",
      "shims/downloads-compat.js",
      "shims/privacy-stub.js",
      "shims/notifications-compat.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "browser_action.html",
    "default_icon": "icons/bookmark32.png",
    "default_title": "Minimal Bookmarks Tree"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "fontSettings",
    "activeTab",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'wasm-unsafe-eval' 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "minimal-bookmarks-tree@converted-extension.org",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/bookmark32.png",
    "128": "icons/bookmark128.png",
    "48": "icons/bookmark128.png"
  },
  "default_locale": "en",
  "omnibox": {
    "keyword": "bm"
  },
  "options_ui": {
    "page": "options.html"
  },
  "optional_host_permissions": [
    "http://*/",
    "https://*/",
    "file://*/"
  ]
}